# Aktiver Spielmodus: freie Entscheidungen benötigen einen echten Modellzugang.
# Google AI Studio / Gemini API mit Gemma (auch AQ.-Autorisierungsschlüssel).
GEMMA_PROVIDER=google
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_API_KEY=

# Für Zustands- und Analyse-Signaturen: einmal erzeugen und dauerhaft behalten.
# Beispiel: openssl rand -hex 32
SIMULATION_SIGNING_KEY=

# Alternative: OpenRouter, dann GEMMA_PROVIDER=openrouter setzen,
# GEMMA_BASE_URL=https://openrouter.ai/api/v1 und
# GEMMA_MODEL=google/gemma-3-27b-it (oder verfügbares Gemma-Modell).
OPENROUTER_API_KEY=

# Weitere Alternative: OpenAI-kompatibler Veranstalter-Endpunkt (Basis-URL mit /v1).
# GEMMA_PROVIDER=openai
# GEMMA_BASE_URL=https://example.org/v1

# ElevenLabs: ELEVENLABS_API_KEY allein aktiviert Figurenstimmen (TTS) und die Sprachfrage an
# Professor Igel (STT -> Gemma -> TTS) über /api/audio/*. Der Schlüssel bleibt serverseitig.
# Lokal in .env.local eintragen (gitignored). Soundeffekte/Musik: node --env-file=.env.local scripts/generate-audio.mjs
# ELEVENLABS_AGENT_ID zusätzlich: privater Agent mit den Client Tools aus docs/voice-agent.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
