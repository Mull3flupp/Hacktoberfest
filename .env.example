# Ohne Schlüssel ist der komplette Klick-/Text-Spielablauf mit kuratierten Erklärungen spielbar.
# Gemma über OpenRouter:
OPENROUTER_API_KEY=
GEMMA_MODEL=google/gemma-3-27b-it

# Alternativ: OpenAI-kompatibler Gemma-Endpunkt des Veranstalters (Basis-URL mit /v1).
# GEMMA_BASE_URL=https://example.org/v1
# GEMMA_API_KEY=

# ElevenLabs: privater Agent mit den Client Tools aus docs/voice-agent.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
